# ---------------------------------------------------------------------------
# Café Finder Server — environment variables
# Copy to `server/.env` and fill in real values. Never commit .env files.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafefinder?schema=public

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# High-entropy secret used to sign JWT access + refresh tokens.
# Generate one with:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Access token lifetime in minutes, refresh in days.
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
# e.g. http://localhost:5173,https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# Set to true in production to restrict cookies to HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Images & maps (external providers)
# ---------------------------------------------------------------------------
# Only the API key needed server-side. Client uses its own VITE_ keys.
MAPS_SERVER_API_KEY=

# Storage bucket for café photos (S3-compatible / Cloudinary).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=