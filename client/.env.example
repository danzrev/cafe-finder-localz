# ---------------------------------------------------------------------------
# Café Finder Client — environment variables
# Copy to `client/.env` and fill in real values. Never commit .env files.
# All Vite vars must be prefixed with VITE_ to be exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the Express API. Leave as `/api` when using the Vite dev proxy.
VITE_API_BASE_URL=/api

# Google Maps JavaScript API key (enable Maps JavaScript API + Geocoding).
# Used to render the café map and pick a location on the submit form.
VITE_MAPS_API_KEY=

# Optional: override the Maps loader bootstrap URL.
VITE_MAPS_LIBRARY_URL=https://maps.googleapis.com/maps/api/js

# Base URL of your external image storage (S3-compatible / Cloudinary CDN).
# Presentation layer reads image URLs from here or from the API directly.
VITE_IMAGE_CDN_BASE=

# Storage provider settings used by the client-side upload flow.
# e.g. Cloudinary upload preset, or S3 presigned bucket.
VITE_STORAGE_PRESET=
VITE_STORAGE_ENDPOINT=